# Credenciais públicas do projeto Supabase usadas pelo navegador para invocar a Edge Function.
# Preencha apenas no ambiente do projeto/deploy. Não coloque GOOGLE_PLACES_API_KEY aqui.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# GOOGLE_PLACES_API_KEY é privada e deve existir somente em:
# Supabase Dashboard -> Edge Function Secrets
